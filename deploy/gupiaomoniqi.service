[Unit]
Description=Stock Simulator API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=gupiaomoniqi
Group=gupiaomoniqi
WorkingDirectory=/opt/gupiaomoniqi/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3100
Environment=DATABASE_DIR=/var/lib/gupiaomoniqi/pgdata
Environment=REAL_DATABASE_DIR=/var/lib/gupiaomoniqi/real-pgdata
Environment=MARKET_SEED_PATH=/var/lib/gupiaomoniqi/market-seeds.json
Environment=REAL_MARKET_SYNC_ENABLED=true
ExecStart=/usr/local/bin/node /opt/gupiaomoniqi/current/server/dist/index.js
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/gupiaomoniqi
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
